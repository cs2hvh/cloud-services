{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "admin:dev",
        "--prefix",
        "C:\\cloud-admin-panel"
      ],
      "port": 3001
    },
    {
      "name": "next-dev",
      "autoPort": true,
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:next"
      ],
      "port": 3000
    },
    {
      "name": "next-dev-fast",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:fast"
      ],
      "port": 3000,
      "autoPort": false
    },
    {
      "//": "Explicit project directory. Without it the preview resolved to another checkout that also has app/(marketing)/services/compute, so a new route here 404'd while an existing one served fine.",
      "name": "cloud-services-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "-p", "3007", "C:\\cloud-services"],
      "port": 3007
    },
    {
      "name": "v2-ui-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "dev",
        "-p",
        "3021"
      ],
      "port": 3021
    },
    {
      "name": "v2-ui-start",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3022"
      ],
      "port": 3022
    }
  ]
}
