apiVersion: v1
kind: Secret
metadata:
  name: ahura-eval-runner-secrets
  namespace: ahura
type: Opaque
stringData:
  REDIS_URL: "${REDIS_URL}"
  SUPABASE_URL: "${SUPABASE_URL}"
  SUPABASE_SERVICE_ROLE_KEY: "${SUPABASE_SERVICE_ROLE_KEY}"
  INFERENCE_PLATFORM_KEY: "${INFERENCE_PLATFORM_KEY}"
  INFERENCE_BASE_URL: "${INFERENCE_BASE_URL}"
  CONCURRENT_CASES: "4"
  CASE_TIMEOUT_MS: "60000"
  MAX_CONCURRENT_JOBS: "2"
  CLAIM_POLL_INTERVAL_MS: "5000"
