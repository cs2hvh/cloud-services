apiVersion: v1
kind: Secret
metadata:
  name: ahura-deploy-runner-secrets
  namespace: ahura
type: Opaque
stringData:
  REDIS_URL: "${REDIS_URL}"
  SUPABASE_URL: "${SUPABASE_URL}"
  SUPABASE_SERVICE_ROLE_KEY: "${SUPABASE_SERVICE_ROLE_KEY}"
  RUNPOD_API_KEY: "${RUNPOD_API_KEY}"
  LORA_SERVING_ENDPOINT_ID: "${LORA_SERVING_ENDPOINT_ID}"
  MAX_CONCURRENT_JOBS: "4"
