# Secret for the data-runner (RAG connector syncs).
#
# Rendered by infra/k8s/lke/02-apply-all.sh:
#   envsubst < workers/data-runner/k8s/secret.yaml.template | kubectl apply -f -
# with values sourced from ~/.ahura-lke.env (OUTSIDE the repo). Never fill real
# values in here — this file is committed.
#
# Same shape as eval-runner's template (the closest sibling: no GPU, only HTTP
# calls to our own gateway). Doc: nextstespsAI/20-rag-connectors-and-data-runner.md
apiVersion: v1
kind: Secret
metadata:
  name: ahura-data-runner-secrets
  namespace: ahura
type: Opaque
stringData:
  # BullMQ broker — the IN-CLUSTER redis from 03-redis.yaml. This is the shared
  # queue, which is correct here: the k8s runner is the real consumer.
  REDIS_URL: "${REDIS_URL}"
  SUPABASE_URL: "${SUPABASE_URL}"
  SUPABASE_SERVICE_ROLE_KEY: "${SUPABASE_SERVICE_ROLE_KEY}"

  # Embeddings + OCR go through our own gateway so every call is metered and
  # attributed to the customer org via X-Ahura-On-Behalf-Of-Org.
  INFERENCE_PLATFORM_KEY: "${INFERENCE_PLATFORM_KEY}"
  INFERENCE_BASE_URL: "${INFERENCE_BASE_URL}"

  # Decrypts stored S3 credentials and webhook signing secrets. MUST be byte-for-byte
  # the same key the Next app encrypts with, or every S3 connector fails closed.
  BYOK_DEK: "${BYOK_DEK}"

  # ── Tunables (see workers/data-runner/src/env.ts for defaults) ──────────────
  FETCH_CONCURRENCY: "8"
  EMBED_BATCH: "96"
  MAX_CONCURRENT_JOBS: "2"
  CLAIM_POLL_INTERVAL_MS: "5000"
  MAX_DOCUMENTS_PER_SYNC: "10000"

  # OCR fallback for scanned PDFs / image objects (billed per page, on-behalf-of).
  OCR_ENABLED: "true"
  OCR_MODEL: "ahura/ocr-doc"
  OCR_MIN_CHARS: "20"

  # NOTE: CRAWL_ALLOW_PRIVATE and S3_ENDPOINT_ALLOW_PRIVATE are deliberately
  # ABSENT. They default to false, and setting either one here would disable the
  # SSRF private-IP guard in production — letting a customer point a crawl seed
  # or an S3 endpoint at cluster-internal addresses. They exist for local dev only.
