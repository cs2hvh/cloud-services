apiVersion: v1
kind: Secret
metadata:
  name: ahura-agent-runner-secrets
  namespace: ahura
type: Opaque
stringData:
  REDIS_URL: "${REDIS_URL}"
  SUPABASE_URL: "${SUPABASE_URL}"
  SUPABASE_SERVICE_ROLE_KEY: "${SUPABASE_SERVICE_ROLE_KEY}"
  INFERENCE_PLATFORM_KEY: "${INFERENCE_PLATFORM_KEY}"
  INFERENCE_BASE_URL: "${INFERENCE_BASE_URL}"
  # Decrypts registry-mode MCP server auth tokens (doc 14 M3) — same DEK the
  # Next.js app's BYOK_DEK encrypts with. Absent = registry servers with a
  # stored token silently fail closed (skipped, never a run failure) — not a
  # crash, but MCP registry auth won't work until this is set.
  BYOK_DEK: "${BYOK_DEK}"
  MODEL_TURN_TIMEOUT_MS: "120000"
  MAX_CONCURRENT_JOBS: "4"
  CLAIM_POLL_INTERVAL_MS: "5000"
