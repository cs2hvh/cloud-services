# Template for the ahura-ft-runner-secrets Secret.
#
# DO NOT commit a filled-in version. Render via:
#   envsubst < secret.yaml.template | kubectl apply -f -
# Or use SealedSecrets / ExternalSecrets / sops in real deployments.
apiVersion: v1
kind: Secret
metadata:
  name: ahura-ft-runner-secrets
  namespace: ahura
type: Opaque
stringData:
  # BullMQ Redis — must be ioredis-compatible URL.
  # NOTE: Upstash REST API does NOT work for BullMQ. You need either:
  #   - Upstash Redis with "Enable TLS / Redis-Cli" toggle on (rediss://)
  #   - A self-managed Redis 6+ inside the cluster
  REDIS_URL: "${REDIS_URL}"

  # Heartbeat reads — Upstash REST (shared with the Next.js /heartbeat route).
  UPSTASH_REDIS_REST_URL: "${UPSTASH_REDIS_REST_URL}"
  UPSTASH_REDIS_REST_TOKEN: "${UPSTASH_REDIS_REST_TOKEN}"

  # Postgres (Supabase). Service-role key — never expose to the cluster
  # data plane.
  SUPABASE_URL: "${SUPABASE_URL}"
  SUPABASE_SERVICE_ROLE_KEY: "${SUPABASE_SERVICE_ROLE_KEY}"

  # RunPod
  RUNPOD_API_KEY: "${RUNPOD_API_KEY}"

  # Where to POST webhooks back to (the Next.js app).
  CONTROL_PLANE_URL: "${CONTROL_PLANE_URL}" # e.g. https://ahurasense.com
  FT_WEBHOOK_SECRET: "${FT_WEBHOOK_SECRET}" # MUST match Next.js env

  # R2 (Cloudflare). Passed through to training pods for dataset+adapter I/O.
  R2_ACCESS_KEY_ID: "${R2_ACCESS_KEY_ID}"
  R2_SECRET_ACCESS_KEY: "${R2_SECRET_ACCESS_KEY}"
  R2_ENDPOINT: "${R2_ENDPOINT}" # e.g. https://<accountid>.r2.cloudflarestorage.com

  # Training image — defaults to the latest GHCR tag if omitted.
  AXOLOTL_IMAGE_URI: "ghcr.io/hav0ky/ahura-ft-axolotl:axolotl-0.29.0"

  # Optional HF token for gated bases (Llama-3.x, Gemma-4, etc.)
  HF_TOKEN: "${HF_TOKEN}"

  # Tunables
  MAX_CONCURRENT_JOBS: "4"
