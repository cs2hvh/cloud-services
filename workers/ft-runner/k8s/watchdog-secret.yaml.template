# Secret for the ahura-finetune-watchdog CronJob.
#
# Fill these from your environment (the same values the app/ft-runner use) and
# apply via envsubst so the real values never get committed:
#
#   export CONTROL_PLANE_URL="https://<your-app-host>"
#   export BATCH_PROCESSOR_TOKEN="<the app's BATCH_PROCESSOR_TOKEN>"
#   envsubst < workers/ft-runner/k8s/watchdog-secret.yaml.template | kubectl apply -f -
#
# CONTROL_PLANE_URL   — public base URL of the Next.js control plane (same value
#                       the ft-runner already uses; no trailing path).
# BATCH_PROCESSOR_TOKEN — must match the app's BATCH_PROCESSOR_TOKEN env; it's the
#                       X-Ahura-Internal-Token the watchdog endpoint checks.
apiVersion: v1
kind: Secret
metadata:
  name: ahura-finetune-watchdog-secrets
  namespace: ahura
type: Opaque
stringData:
  CONTROL_PLANE_URL: "${CONTROL_PLANE_URL}"
  BATCH_PROCESSOR_TOKEN: "${BATCH_PROCESSOR_TOKEN}"
