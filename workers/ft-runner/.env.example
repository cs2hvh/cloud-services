# Copy to .env.local and fill in. Never commit .env.local.

# BullMQ — standard Redis URL (NOT Upstash REST)
REDIS_URL=redis://localhost:6379

# Heartbeat reader — Upstash REST (shared with Next.js)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# RunPod
RUNPOD_API_KEY=

# Webhooks
CONTROL_PLANE_URL=https://app.ahurasense.com
FT_WEBHOOK_SECRET=

# R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# Training image (defaults if unset)
AXOLOTL_IMAGE_URI=ghcr.io/hav0ky/ahura-ft-axolotl:axolotl-0.29.0

# Optional — for gated HF models
HF_TOKEN=

# Tunables (optional — sane defaults baked in)
MAX_CONCURRENT_JOBS=4
LOG_LEVEL=info
