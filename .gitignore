# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/credit-system-cron/node_modules
workers/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright
/test-results
/playwright-report
/playwright/.cache
tests/e2e/.auth/
test-results*.json
test-output.json
vitest-report.json

# next.js
/.next/
/out/
/project-demos
/app-platform
# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit local secrets)
.env
.env.local
env.local
.env.*.local
.env.dev
.env.prod
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Auto Claude data directory
.auto-claude/

# Auto Claude generated files
.auto-claude-security.json
.auto-claude-status
.claude_settings.json
.worktrees/
.security-key
logs/security/

# local migration/backups scratch artifacts
supabase/migrations_disabled/
supabase/.temp/
supabase/.branches/
/backups/
# local Jenkins runtime data (generated by infra/jenkins/docker-compose)
infra/jenkins/data/

# Cloudflare Workers
workers/*/.wrangler/
workers/*/dist/
workers/*/test/load-result.json

