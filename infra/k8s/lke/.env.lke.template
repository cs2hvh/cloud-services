# Template for ~/.ahura-lke.env. Lives OUTSIDE the repo so it can never
# be accidentally committed. Fill in real values, then:
#   cp infra/k8s/lke/.env.lke.template ~/.ahura-lke.env
#   chmod 600 ~/.ahura-lke.env
#   # edit ~/.ahura-lke.env
#   set -a; source ~/.ahura-lke.env; set +a
#   bash infra/k8s/lke/02-apply-all.sh

# ── Redis for BullMQ (in-cluster from 03-redis.yaml) ──────────────
REDIS_URL=redis://redis.ahura.svc.cluster.local:6379

# ── Heartbeat reads (Upstash REST) ────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── RunPod ────────────────────────────────────────────────────────
RUNPOD_API_KEY=

# ── Webhooks / control plane ──────────────────────────────────────
CONTROL_PLANE_URL=https://ahurasense.com
# Generate with: openssl rand -hex 32
# MUST match the value in your Next.js production env.
FT_WEBHOOK_SECRET=

# ── R2 (for FT dataset I/O + adapter upload) ──────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# ── Inference gateway (eval-runner + data-runner) ─────────────────
# INFERENCE_PLATFORM_KEY: a key from inference.api_keys flagged
# is_internal_service, so the gateway resolves billing to the customer
# org via X-Ahura-On-Behalf-Of-Org.
INFERENCE_PLATFORM_KEY=
INFERENCE_BASE_URL=https://api.ahurasense.com/v1

# ── data-runner (RAG connectors) ──────────────────────────────────
# Decrypts stored S3 credentials + webhook signing secrets. MUST be the
# SAME base64 32-byte key as the Next app's BYOK_DEK, or every S3
# connector sync fails closed.
BYOK_DEK=

# ── Optional ──────────────────────────────────────────────────────
HF_TOKEN=
LORA_SERVING_ENDPOINT_ID=
